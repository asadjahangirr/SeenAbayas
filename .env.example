# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep indexing disabled until the store is ready for launch.
SITE_INDEXING_ENABLED=false

# preview = photos; development = explicitly temporary sizes/stock; supabase = published database catalogue.
# Keep indexing disabled for development data. Replace all sample quantities before launch.
CATALOG_SOURCE=preview

# files = original checked-in content; supabase = published admin content.
# Apply both administration migrations before enabling this.
CMS_SOURCE=files

# Set both together. Use sb_publishable_ keys, never sb_secret_ or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact email: server-only API key and a plain email address on a verified Resend domain.
# Sending remains disabled unless all four contact settings are valid.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile managed widget. Allow localhost for development and your actual domain for launch.
# Site key is public; secret key must remain server-only. Never prefix secrets with NEXT_PUBLIC_.
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=

# Optional admin inbox copy of verified, successfully emailed enquiries.
# Server-only Supabase secret key. Never prefix this with NEXT_PUBLIC_.
# Admin sign-in, products and media do not need this key.
CONTACT_INBOX_ENABLED=false
SUPABASE_SECRET_KEY=
