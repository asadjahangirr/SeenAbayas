# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep indexing disabled until the store is ready for launch.
SITE_INDEXING_ENABLED=false

# preview = photos; development = explicitly temporary sizes/stock; supabase = published database catalogue.
# Keep indexing disabled for development data. Replace all sample quantities before launch.
CATALOG_SOURCE=preview

# files = original checked-in content; supabase = published admin content.
# Apply both administration migrations before enabling this.
CMS_SOURCE=files

# Set both together. Use sb_publishable_ keys, never sb_secret_ or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact messages default to Admin -> Inbox. No Resend sender is required for inbox mode.
# Requires the existing Supabase URL/server secret and contact-inbox migration.
# Use email only if you deliberately want contact enquiries emailed instead.
CONTACT_DELIVERY=inbox
# Resend is also used by order emails independently of contact delivery.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional for CONTACT_DELIVERY=email only. Inbox delivery does not use Turnstile.
# Site key is public; secret key must remain server-only. Never prefix secrets with NEXT_PUBLIC_.
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=

# Optional inbox copy when CONTACT_DELIVERY=email; inbox mode always stores messages.
# Server-only Supabase secret key. Never prefix this with NEXT_PUBLIC_.
# Admin sign-in, products and media do not need this key.
CONTACT_INBOX_ENABLED=false
SUPABASE_SECRET_KEY=

# Stripe-hosted Checkout: disabled, test or live. See docs/DOMAIN_PAYMENT_SETUP.md.
# Live requires the 20261021000100 migration, separate sandbox credentials and HTTPS.
# Use the client's sandbox/test account first; never paste keys into chat.
PAYMENTS_MODE=disabled
# Explicit client choice: no added tax. This does not establish VAT registration status.
PAYMENTS_TAX_MODE=none
STRIPE_SECRET_KEY=
# Add this only after setting up the integration's webhook listener/endpoint.
# A webhook signing secret (whsec_...) is different from the API secret key.
STRIPE_WEBHOOK_SECRET=
# Preserve the old sandbox API/signing keys here when the primary keys become live.
# Also permits switching PAYMENTS_MODE=test without exposing live payments.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Scheduled reservation recovery: generate 32-256 random characters privately.
# See docs/STOCK_SETUP.md for Supabase Cron with a timestamped HMAC proof.
# External schedulers can also use Authorization: Bearer <secret> with GET/POST.
PAYMENTS_RECONCILE_SECRET=

# Paid-order emails. Verify the sending domain in Resend first. No mailbox password.
# Sends customer confirmations plus owner notifications to info@seenabayas.co.uk.
# Independent of the Contact form / Turnstile setup. See docs/ORDER_EMAIL_SETUP.md.
ORDER_EMAILS_ENABLED=false
ORDER_FROM_EMAIL=
# Optional controlled sandbox inbox. Empty = sandbox emails are suppressed.
# Both sandbox messages go here, never to fictional checkout addresses.
ORDER_EMAIL_TEST_RECIPIENT=

# Royal Mail Click & Drop. Calculated rates require shipping_quotes SQL + published admin setup.
# Server-only Click & Drop API key. Never use NEXT_PUBLIC_ or commit the real value.
# Confirm the key source/account type before adding it. See docs/ROYAL_MAIL_SETUP.md.
ROYAL_MAIL_API_KEY=
# bearer follows the public schema; raw supports the token header in the help guide.
ROYAL_MAIL_AUTH_MODE=bearer
